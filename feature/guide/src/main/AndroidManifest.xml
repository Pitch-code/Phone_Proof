<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Declared in this module rather than in the app, so the feature that needs it carries it. A
          library manifest is merged into the app's, and ${applicationId} resolves at merge time.

          Why a provider at all: the walkthrough photograph is written by the phone's own camera app, and a
          bare file:// URI has not been accepted across an intent boundary since Android 7 — it raises
          FileUriExposedException. FileProvider hands out a content:// URI whose grant is scoped to one
          file and lasts for one intent.

          Declared as a WalkthroughFileProvider subclass rather than as androidx.core.content.FileProvider
          directly, because feature:reports already declares one of those for sharing a report PDF and two
          providers with the same class name fail the manifest merge. See WalkthroughFileProvider.

          Why the camera app rather than an in-app viewfinder: this is a buyer photographing a water
          sticker inside a SIM slot, in a shop, one-handed. The camera app has tap-to-focus, a flash
          toggle, zoom and macro — all of which matter for that shot and none of which this app should
          reimplement. It also means no CAMERA permission is needed for this feature, because the app
          never opens the camera itself.
        -->
        <provider
            android:name="com.phoneproof.feature.guide.WalkthroughFileProvider"
            android:authorities="${applicationId}.walkthroughphotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/walkthrough_paths" />
        </provider>
    </application>
</manifest>
