<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon variant, for Android 13+ where the launcher throws every colour away and tints the
  whole mark one flat shade.

  This is NOT the colour foreground with the colours removed, and it cannot be. There, the pulse is
  green on a solid white body; strip the colour and it becomes the tint drawn on the tint - a blank
  slab with the entire point of the icon invisible. The same trap the previous mark's dead cell fell
  into, which is why that one omitted the cell rather than recolouring it.

  So the body is an outline here and the pulse sits in the empty middle, where it reads against
  transparency instead of against fill.

  Slightly smaller than the colour version on purpose: a 7-wide stroke straddles the path, adding 3.5
  on every side, so the body is inset to 40..68 x 27..81 to keep its corners inside the 36-from-centre
  circle a launcher may crop to. Same silhouette, drawn to survive a different rule.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:strokeColor="#FAFAFA"
        android:strokeWidth="7"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M46,27h16a6,6 0 0,1 6,6v42a6,6 0 0,1 -6,6h-16a6,6 0 0,1 -6,-6V33a6,6 0 0,1 6,-6z" />

    <path
        android:strokeColor="#FAFAFA"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M45,54h3.5l3.5,-7l4.5,13l3.5,-6h4" />
</vector>
